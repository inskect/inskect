INSKECT_CORS_ORIGINS=["http://localhost:3000"]
INSKECT_MAX_CONCURRENT_SCANS=2
# Running + waiting scans; new scans get a 503 beyond this.
INSKECT_MAX_QUEUED_SCANS=20
# Store scans in Postgres instead of data/scans.db.
INSKECT_DATABASE_URL=
# Live scan logs and progress, and rate-limit counts: memory (this process only, lost on restart)
# or database (kept across restarts). Unset: database with Postgres, memory with SQLite.
INSKECT_LOG_STORE=
INSKECT_RATE_LIMIT_STORE=
# Who can use the server: none (default: no sign-in, full access for anyone who can reach it,
# admin page included) or accounts (sign-in required; the first account is the admin).
INSKECT_AUTH=
# AI review: the providers scans may use, as a JSON list, e.g. ["anthropic"] (unset: all of them);
# whether a scan may point a provider at its own endpoint (true by default); and whether admins may
# sign this server in to Claude Code for everyone (true by default).
INSKECT_AI_PROVIDERS=
INSKECT_ALLOW_CUSTOM_AI_URL=
INSKECT_CLAUDE_CLI=
# Encrypts the Claude keys users save to their account. Generate: uv run python -m app.secrets_box
INSKECT_SECRET_KEY=
# Password reset emails, over SMTP: they switch on when SMTP_HOST, MAIL_FROM and PUBLIC_URL are set.
INSKECT_SMTP_HOST=
INSKECT_SMTP_PORT=
INSKECT_SMTP_USERNAME=
INSKECT_SMTP_PASSWORD=
# starttls (587), ssl (465) or none (local relay only).
INSKECT_SMTP_SECURITY=
INSKECT_MAIL_FROM=
# This app's public address, used for links in emails, e.g. https://inskect.example.com
INSKECT_PUBLIC_URL=
# Auto-delete scans older than this many days. Unset (default) keeps history forever.
INSKECT_SCAN_RETENTION_DAYS=
# Scans per user per 24 hours, and in progress at once (admins exempt). 0 or unset = no limit.
# Admins can change them, and pause scans, from the backoffice.
INSKECT_DAILY_SCAN_QUOTA=
INSKECT_CONCURRENT_SCAN_QUOTA=
# The hourly sweep of expired scans, sessions and activity in the API process (true by default).
INSKECT_RETENTION_LOOP=
# skillspector's own analysis settings, for every scan (docs/CONFIGURATION.md). Unset keeps
# skillspector's defaults. Extra YARA rules: a directory, relative to backend/.
INSKECT_YARA_RULES_DIR=
# The language AI review explains findings in, e.g. French.
INSKECT_OUTPUT_LANGUAGE=
INSKECT_REASONING_EFFORT=
INSKECT_TEMPERATURE=
INSKECT_MAX_LLM_CONCURRENCY=
INSKECT_OSV_TIMEOUT_SECONDS=
INSKECT_MAX_WORKFLOW_SECONDS=
INSKECT_MAX_STATIC_ANALYSIS_SECONDS_PER_ARTIFACT=
